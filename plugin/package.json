{
  "name": "dsh-remote",
  "version": "0.1.1",
  "description": "DSH 插件：把终端里的 dsh 经 frp 隧道连到自建服务器 —— 渲染 frpc.toml、隐藏窗口跑 frpc、断线重拉、随 dsh 起停、体检与状态工具。顶替原来的 VBS + 计划任务 + 手写配置。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "frp",
    "frpc",
    "tunnel",
    "remote-access"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test/run.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c1overzz/dsh-remote.git"
  },
  "license": "MIT"
}