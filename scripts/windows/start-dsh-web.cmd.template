@echo off
setlocal
rem Generated by New-DshClient.ps1. Do not edit the placeholders by hand.
if not defined DSH_CLI set "DSH_CLI=%LOCALAPPDATA%\Programs\DeepSeek Harness\resources\runtime\cli\bin\dsh.cmd"
if not defined DSH_WORKSPACE set "DSH_WORKSPACE=%USERPROFILE%"

if not exist "%DSH_CLI%" (
  echo [dsh-web] DSH CLI not found: %DSH_CLI%
  exit /b 1
)
if not exist "%DSH_WORKSPACE%" (
  echo [dsh-web] workspace not found: %DSH_WORKSPACE%
  exit /b 1
)

cd /d "%DSH_WORKSPACE%"
"%DSH_CLI%" --profile web --no-open --host 127.0.0.1 --port 3080 --trusted-host __PC_NAME__.__BASE_DOMAIN__ --trusted-host __PC_NAME__.__BASE_DOMAIN__:443 --public-url https://__PC_NAME__.__BASE_DOMAIN__/
exit /b %ERRORLEVEL%
