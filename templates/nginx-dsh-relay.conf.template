# nginx-dsh-relay.conf.template
# Rendered by scripts/server/install-nginx-site.sh.
# The map must live in the http {} context (an included site file is in http).

map $http_upgrade $dsh_connection_upgrade {
    default upgrade;
    ''      close;
}

# ---------------------------------------------------------------------------
# HTTP: ACME + redirect. Some clouds block new subdomains on port 80 before
# nginx is reached; HTTPS remains the supported path.
# ---------------------------------------------------------------------------

server {
    listen 80;
    server_name dsh.__BASE_DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 80;
    server_name pc-a.__BASE_DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 80;
    server_name pc-b.__BASE_DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------------------
# HTTPS portal (basic auth + PWA)
# ---------------------------------------------------------------------------

server {
    listen 443 ssl http2;
    server_name dsh.__BASE_DOMAIN__;

    ssl_certificate     /etc/nginx/ssl/dsh-relay.pem;
    ssl_certificate_key /etc/nginx/ssl/dsh-relay.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:DSHSSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;

    root  /srv/dsh-portal;
    index index.html;

    auth_basic           "DSH portal";
    auth_basic_user_file /etc/nginx/.htpasswd-dsh;

    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    location = /sw.js {
        add_header Cache-Control "no-cache";
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ---------------------------------------------------------------------------
# HTTPS PC A -> 127.0.0.1:13080
# ---------------------------------------------------------------------------

server {
    listen 443 ssl http2;
    server_name pc-a.__BASE_DOMAIN__;

    ssl_certificate     /etc/nginx/ssl/dsh-relay.pem;
    ssl_certificate_key /etc/nginx/ssl/dsh-relay.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:DSHSSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:13080;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $dsh_connection_upgrade;

        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
        proxy_buffering     off;
        client_max_body_size 100m;
    }
}

