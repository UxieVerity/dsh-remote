# nginx-pc.conf.template
# Rendered by scripts/server/add-pc.sh into /etc/nginx/dsh-pcs/<name>.conf.
# One pair of blocks per PC; there is no fixed PC count.

server {
    listen 80;
    server_name __PC_NAME__.__BASE_DOMAIN__;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name __PC_NAME__.__BASE_DOMAIN__;

    ssl_certificate     /etc/nginx/ssl/dsh-relay.pem;
    ssl_certificate_key /etc/nginx/ssl/dsh-relay.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:DSHSSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:__REMOTE_PORT__;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $dsh_connection_upgrade;

        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
        proxy_buffering     off;
        client_max_body_size 100m;
    }
}
